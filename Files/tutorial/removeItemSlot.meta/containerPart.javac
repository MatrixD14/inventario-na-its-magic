//C-R:removeItemSlot
class removeItemSlot { //[I-S]LN=0;[I-E]
  public void caractItems(item2 itemRm, int value, SpatialObject obj, ObjectFile drop) { //[I-S]LN=1;[I-E]
Vector3 mypos = obj.getGlobalPosition(); //[I-S]LN=2;[I-E]
    SpatialObject itemDrop = obj.instantiate(drop, mypos); //[I-S]LN=3;[I-E]
    itemDrop.setName(itemRm.name); //[I-S]LN=4;[I-E]
     //[I-S]LN=5;[I-E]
    itemDrop.setTag("item"); //[I-S]LN=6;[I-E]
     //[I-S]LN=7;[I-E]
    itemDrop.setStatic(false); //[I-S]LN=8;[I-E]
    itemDrop.getPhysics().setPhysicsEntity(new Rigidbody()); //[I-S]LN=9;[I-E]
    if (itemDrop.findComponent("item2") == null) itemDrop.addComponent(new item2()); //[I-S]LN=10;[I-E]
    item2 addDados = itemDrop.findComponent("item2"); //[I-S]LN=11;[I-E]
 //[I-S]LN=12;[I-E]
    if (itemDrop.findComponent("Collider") == null) itemDrop.addComponent(new Collider()); //[I-S]LN=13;[I-E]
    Collider itemCollider = itemDrop.findComponent("Collider"); //[I-S]LN=14;[I-E]
 //[I-S]LN=15;[I-E]
    if (itemDrop.findComponent("ModelRenderer") == null) itemDrop.addComponent(new ModelRenderer()); //[I-S]LN=16;[I-E]
    ModelRenderer itemModel = itemDrop.findComponent("ModelRenderer"); //[I-S]LN=17;[I-E]
 //[I-S]LN=18;[I-E]
    if (addDados != null) { //[I-S]LN=19;[I-E]
      DadosItens(addDados, itemRm); //[I-S]LN=20;[I-E]
      addDados.MaxTrag = value; //[I-S]LN=21;[I-E]
    } //[I-S]LN=22;[I-E]
    if (itemModel != null) itemModel.setModelFile(itemRm.Vertex); //[I-S]LN=23;[I-E]
    if (itemCollider != null) { //[I-S]LN=24;[I-E]
      itemCollider.setShape(4); //[I-S]LN=25;[I-E]
      itemCollider.setVertexFile(itemRm.Vertex); //[I-S]LN=26;[I-E]
    }  //[I-S]LN=27;[I-E]
  } //[I-S]LN=28;[I-E]
 //[I-S]LN=29;[I-E]
  private void DadosItens(item2 arm, item2 dados) { //[I-S]LN=30;[I-E]
    arm.name = dados.name; //[I-S]LN=31;[I-E]
    arm.ui = dados.ui; //[I-S]LN=32;[I-E]
    arm.type = dados.type; //[I-S]LN=33;[I-E]
    arm.value = dados.value; //[I-S]LN=34;[I-E]
    arm.MaxTrag = dados.MaxTrag; //[I-S]LN=35;[I-E]
    arm.Vertex = dados.Vertex; //[I-S]LN=36;[I-E]
  } //[I-S]LN=37;[I-E]
} //[I-S]LN=38;[I-E]